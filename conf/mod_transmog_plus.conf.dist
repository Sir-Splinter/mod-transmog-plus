[worldserver]

###################################################################################################
#    Transmogrification config
###################################################################################################
#
#    SETTINGS
#
#    Transmog.Enable
#        Description: Enables/Disables transmog.
#                     Players won't be able to see any transmogrified item while disabled, however, database data remains intact.
#        Default:     1
#
#    Transmog.PriceCopper
#        Description: Flat copper cost per transmogrified slot.
#        Default:     1000 (10 Silver)
#
#    Transmog.Allowed
#        Description: A list of item entries that are allowed for transmogrification (skips quality and CanUseItem check)
#                     Example: "25 35674 5623"
#        Default:    ""
#
#    Transmog.NotAllowed
#        Description: A list of item entries that are NOT allowed for transmogrification
#                     Example: "25 35674 5623"
#        Default:    ""
#

Transmog.Enable = 1
Transmog.PriceCopper = 1000
Transmog.Allowed = ""
Transmog.NotAllowed = ""

###################################################################################################
#    TRANSMOG COLLECTION UNLOCK RULES
###################################################################################################
#
# Collection and usage are separate:
#   - Collection rules determine whether an appearance is learned for the account.
#   - Existing transmog rules still determine whether a character can apply it.
#
#    Transmog.CollectionUnlockSource
#        0 = EQUIPPED_ONLY (LEGACY)
#            Learn an appearance only when an eligible item is equipped. This preserves the
#            original module behavior.
#
#        1 = ACQUIRED (CUSTOM / RETAIL-INSPIRED FOUNDATION)
#            Consider an item when it is stored in the player's inventory. The generic core
#            storage hook covers normal loot, quest rewards, group rewards, crafting, vendors,
#            trades, mail/AH delivery, containers, scripted rewards, and GM-created items.
#            Binding and eligibility settings below decide whether it is actually learned.
#
#        Default: 0
#
#    Transmog.CollectionBindingRequirement
#        Used only when CollectionUnlockSource = 1.
#
#        0 = ANY (CUSTOM CONVENIENCE)
#            Learn any otherwise eligible acquired item, including freely tradable BoE items.
#            This is more permissive than retail because acquisition alone is sufficient.
#
#        1 = BIND_ON_PICKUP_ONLY (CUSTOM STRICT)
#            Learn acquired items only when their template is Bind on Pickup. Eligible BoE items
#            may still be learned when equipped if CollectionUnlockOnEquip is enabled.
#
#        2 = PERMANENTLY_BOUND (RETAIL-INSPIRED)
#            Learn acquired items only when already soulbound, or when the item template is BoP.
#            This approximates modern retail ownership rules but does not emulate every refund,
#            temporary trade-window, cosmetic, profession, legendary, or special-item exception.
#
#        Default: 0
#
#    Transmog.CollectionEligibility
#        0 = CHARACTER_USABLE (LEGACY / CUSTOM)
#            The acquiring character must satisfy the module's class, race, faction, proficiency,
#            skill, spell, quality, event, and item-category rules. Example: a mage does not
#            collect plate unless existing Ignore/Allow settings make it valid.
#
#        1 = ACCOUNT_COLLECTIBLE (RETAIL-INSPIRED)
#            Learn an otherwise collectible armor/weapon appearance even when the acquiring
#            character cannot personally use that class or proficiency. Existing restrictions
#            are still checked when another character attempts to apply the appearance.
#            Example: a mage may collect plate for the account but cannot wear that appearance.
#
#        Default: 0
#
#    Transmog.CollectionUnlockOnEquip
#        0 = Do not unlock specifically from equipping.
#        1 = Preserve the original module's equip-time unlock behavior in addition to acquisition
#            rules. Recommended for backward compatibility and for learning BoE items when they
#            become bound through equipping.
#
#        Default: 1
#
# PRESET: LEGACY (original module behavior)
#   CollectionUnlockSource = 0
#   CollectionBindingRequirement = 0
#   CollectionEligibility = 0
#   CollectionUnlockOnEquip = 1
#
# PRESET: CUSTOM - every class-usable acquired item
#   CollectionUnlockSource = 1
#   CollectionBindingRequirement = 0
#   CollectionEligibility = 0
#   CollectionUnlockOnEquip = 1
#
# PRESET: CUSTOM - class-usable acquired BoP items only
#   CollectionUnlockSource = 1
#   CollectionBindingRequirement = 1
#   CollectionEligibility = 0
#   CollectionUnlockOnEquip = 1
#
# PRESET: RETAIL-INSPIRED account collection
#   CollectionUnlockSource = 1
#   CollectionBindingRequirement = 2
#   CollectionEligibility = 1
#   CollectionUnlockOnEquip = 1
#

Transmog.CollectionUnlockSource = 0
Transmog.CollectionBindingRequirement = 0
Transmog.CollectionEligibility = 0
Transmog.CollectionUnlockOnEquip = 1

#
#    REQUIREMENTS
#
#    Transmog.AllowPoor
#        Description: Allow poor quality items to be used as source and target items
#        Default:    1
#
#    Transmog.AllowCommon
#        Description: Allow common quality items to be used as source and target items
#        Default:    1
#
#    Transmog.AllowUncommon
#        Description: Allow uncommon quality items to be used as source and target items
#        Default:    1
#
#    Transmog.AllowRare
#        Description: Allow rare quality items to be used as source and target items
#        Default:    1
#
#    Transmog.AllowEpic
#        Description: Allow epic quality items to be used as source and target items
#        Default:    1
#
#    Transmog.AllowLegendary
#        Description: Allow legendary quality items to be used as source and target items
#        Default:    1
#
#    Transmog.AllowArtifact
#        Description: Allow artifact quality items to be used as source and target items
#        Default:    1
#
#    Transmog.AllowHeirloom
#        Description: Allow heirloom quality items to be used as source and target items
#        Default:    1
#
#    Transmog.AllowMixedArmorTypes
#        Description: Allow cloth items to be transmogrified with plate for example
#        Default:    0
#
#    Transmog.AllowLowerTiers
#        Description: Allows using any armor tier the player can equip (i.e. Warrior plate->cloth | Mage cloth)
#        Default:    0
#
#    Transmog.AllowMixedOffhandArmorTypes
#        Description: Allow shields, offhands (i.e. lamps), and bucklers to be used interchangeably
#        Default:    0
#
#    Transmog.AllowMixedWeaponTypes
#        Description: Allow axe to be transmogrified with dagger for example
#        Possible options:
#            Default:    0 - STRICT - Fully restricted like original Blizzard 4.3 transmog - Weapons must be the same weapon type (exceptions: Guns, Crossbows, or Bows)
#                        1 - MODERN - Like later retail WoW, allow swords to be transmogged to axes, etc.
#                        2 - FULL - No restrictions, allow any weapon to be transmogrified to any other weapon
#
#    Transmog.AllowMixedWeaponHandedness
#        Description: Normally main-hand and off-hand weapons can only be transmogged to this same type. Enable to remove this restriction.
#                     Not necessary when AllowMixedWeaponTypes is set to FULL.
#        Default:    1
#
#    Transmog.AllowFishingPoles
#        Description: Allow fishing poles to be transmogrified
#        Default:    0
#
#    Transmog.IgnoreReqRace
#        Description: Ignore required race for source items
#        Default:    0
#
#    Transmog.IgnoreReqClass
#        Description: Ignore required class for source items
#        Default:    0
#
#    Transmog.IgnoreReqSkill
#        Description: Ignore required skill for source items
#        Default:    0
#
#    Transmog.IgnoreReqSpell
#        Description: Ignore required spell for source items
#        Default:    0
#
#    Transmog.IgnoreReqEvent
#        Description: Ignore required event for source items
#        Default:    0
#
#    Transmog.IgnoreReqStats
#        Description: Ignore stat count > 0 requirement for source items
#        Default:    0
#

Transmog.AllowPoor = 1
Transmog.AllowCommon = 1
Transmog.AllowUncommon = 1
Transmog.AllowRare = 1
Transmog.AllowEpic = 1
Transmog.AllowLegendary = 1
Transmog.AllowArtifact = 1
Transmog.AllowHeirloom = 1

Transmog.AllowMixedArmorTypes = 0
Transmog.AllowLowerTiers = 0
Transmog.AllowMixedOffhandArmorTypes = 0

Transmog.AllowMixedWeaponTypes = 1
Transmog.AllowMixedWeaponHandedness = 1
Transmog.AllowFishingPoles = 0

Transmog.IgnoreReqRace = 0
Transmog.IgnoreReqClass = 0
Transmog.IgnoreReqSkill = 0
Transmog.IgnoreReqSpell = 0
Transmog.IgnoreReqEvent = 0
Transmog.IgnoreReqStats = 0

###################################################################################################